{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/intent_patch.schema.json",
  "title": "Intent Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["patch_id", "trt_id", "base_version", "operator_id", "intent_text", "reason", "operations", "status"],
  "properties": {
    "patch_id": { "type": "string", "minLength": 1 },
    "trt_id": { "type": "string", "minLength": 1 },
    "base_version": { "type": "string", "pattern": "^v[0-9]+$" },
    "operator_id": { "type": "string", "minLength": 1 },
    "intent_text": { "type": "string" },
    "reason": { "type": "string" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": {
            "enum": ["test", "add", "replace", "remove", "move", "copy"]
          },
          "path": { "type": "string", "minLength": 1 },
          "from": { "type": "string" },
          "value": {}
        }
      }
    },
    "request_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_lines": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sub_requests": {
      "type": "array",
      "items": { "type": "object" }
    },
    "message": { "type": "string" },
    "dry_run_only": { "type": "boolean" },
    "deployment_allowed_after_success": { "type": "boolean" },
    "failure_action_hint": { "type": "string" },
    "simulation_config_updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headless": { "type": ["boolean", "null"] },
        "dry_run_only": { "type": ["boolean", "null"] },
        "num_envs": { "type": ["integer", "null"], "minimum": 1 },
        "global_seed": { "type": ["integer", "null"], "minimum": 0 },
        "reuse_verified_seed": { "type": ["boolean", "null"] },
        "add_reference_number": { "type": ["integer", "null"], "minimum": 0 },
        "allowed_overlap_ratio": { "type": ["number", "null"], "minimum": 0 },
        "chosen_intervention_mode": {
          "type": ["string", "null"],
          "enum": ["continue-until-arrival", "immediate-stop", null]
        },
        "travel_time": { "type": ["number", "null"], "minimum": 0 },
        "fix_duration": { "type": ["number", "null"], "minimum": 0 },
        "resume_delay": { "type": ["number", "null"], "minimum": 0 },
        "episode_success_requires_reset_cycles": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "manipulator_priority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": ["FCFS", "REQUIRED_FIRST", "UNWANTED_FIRST", "EXPLICIT_TOOL_ORDER", "EXPLICIT_TYPE_ORDER", "HIGHEST_RISK_FIRST", "LOWEST_RISK_FIRST"]
        },
        "ordered_tool_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^tool_(0[1-9]|1[0-9]|2[0-7])$" },
          "uniqueItems": true
        },
        "ordered_normalized_types": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "prioritize": {
          "enum": ["NON_MATCHING_TYPES_FIRST"]
        },
        "reference_normalized_types": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tie_breaker": { "const": "FCFS" },
        "enabled": { "type": "boolean" }
      }
    },
    "status": {
      "enum": ["DRAFT", "REVIEWED", "VALIDATED", "RELEASED", "REJECTED"]
    }
  }
}
