@startuml
title n8n Workflow Activity Diagram - Intent, Candidate Evaluation, and Review

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam wrapWidth 190
skinparam ArrowFontSize 16
skinparam activity {
  FontSize 18
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #475569
}
skinparam partition {
  FontSize 18
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #0F172A
}
skinparam note {
  FontSize 16
  BackgroundColor #FFFBEB
  BorderColor #D97706
}

start

partition "Operator / Chat UI" {
  :Send natural-language chat turn;
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Extract session id;
  :Load chat session state;

  if (Global cancel?) then (yes)
    :Clear session state;
    :Return cancelled message;
    stop
  endif

  if (Pending deployment decision?) then (yes)
    :Build direct deployment decision turn;
  elseif (Pending patch approval?) then (yes)
    :Build direct patch approval turn;
  elseif (Pending required fields?) then (yes)
    :Merge required fields with stored intent;
  else (new turn)
    :Classify dialogue turn through TRT API;
  endif

  if (Help or configuration query?) then (yes)
    :Execute deterministic configuration query;
    :Return answer;
    stop
  elseif (Small talk, confused, or unknown?) then (yes)
    :Return conversational or clarification response;
    stop
  endif

  :Check operator_id, intent_text, and reason\nfor task-change requests;
  if (Required fields missing?) then (yes)
    :Save required-field session state;
    :Ask for missing values;
    stop
  endif
}

partition "Intent to Patch Review\n(sub-workflow)" {
  :GET /intent/context;
}

partition "vLLM" {
  :Extract schema-constrained domain intent JSON;
}

partition "Intent to Patch Review\n(sub-workflow)" {
  if (Output truncated or invalid JSON?) then (yes)
    :Retry model extraction once;
  endif

  if (Supported and complete domain intent?) then (yes)
    :POST /intent/normalize;
    :POST /patch/validate;
    if (IntentPatch valid?) then (yes)
      :Return reviewed candidate patch;
    else (no)
      :Return specific revision or validation reason;
      stop
    endif
  else (clarify / unsupported / system error)
    :Return clarification, unsupported request,\nor system-recovery message;
    stop
  endif
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Summarize candidate patch;
  :Persist patch-approval session state;
}

partition "Operator / Chat UI" {
  :Approve, reject, or request patch revision;
}

partition "Patch Release Approval\n(sub-workflow)" {
  :POST /release/prepare;
  :POST /release/decision;
  if (Patch released?) then (yes)
    :Fetch audit bundle;
  else (rejected / revise)
    :Return operator decision;
    stop
  endif
}

partition "Released TRT to Reconciliation\n(sub-workflow)" {
  :POST /supervisor/reconcile;
  :Align released TRT, current state records,\nand affected lines;
  if (Plan ready or degraded?) then (continue)
    :Return reconciliation plan;
  else (waiting / rejected)
    :Return checkpoint or rejection reason;
    stop
  endif
}

partition "Generate, Simulate, and Select\nCandidate Strategies (sub-workflow)" {
  :Validate strategy-evaluation context;
  if (No effective change?) then (yes)
    :Return no-effect response;
    stop
  elseif (Required strategy fields missing?) then (yes)
    :Return missing-field error;
    stop
  endif

  :POST /strategy/candidates/generate;
}

partition "TRT API Candidate Generator" {
  :Load released TRT, reconciliation plan,\nstate records, and Time-Arrival state;
  :Create deterministic operator-faithful baseline;
}

partition "vLLM" {
  :Generate exploratory candidate strategies\nusing configured prompt profiles;
}

partition "TRT API Candidate Generator" {
  :Validate schema, line scope, allowed overrides,\nand operator-locked fields;
  if (Configured retries exhausted?) then (yes)
    :Classify candidate-generation system failure;
    :Do not reject the operator intent;
    stop
  endif
  :Persist strategy batch (2-8 requested candidates);
}

partition "Generate, Simulate, and Select\nCandidate Strategies (sub-workflow)" {
  :POST /strategy/batches/{id}/run;
  :Wait and poll /strategy/batches/{id};
}

partition "TRT API Sequential Strategy Worker" {
  :Acquire global single-Isaac lock;
  while (Unevaluated candidate remains?) is (yes)
    :Generate candidate-specific ScenarioSpec;
    :Run candidate synchronously through Host Runner;
    if (RunArtifact completed?) then (yes)
      :Extract evidence and thesis metrics;
      :Apply mandatory placement, priority,\nbatch-gating, throughput, and safety gates;
      :Record R_reset as diagnostic, non-blocking evidence;
    else (no)
      :Record system/simulation failure and DATA_INCOMPLETE;
    endif
  endwhile (no)

  :Rank eligible candidates by throughput attainment;
  note right
    Tie breakers:
    1. lower strategy simulation time
    2. candidate strategy id
  end note
}

partition "Generate, Simulate, and Select\nCandidate Strategies (sub-workflow)" {
  if (Selected candidate exists?) then (yes)
    :Build candidate comparison and selected evidence;
  elseif (Every candidate conclusively evaluated?) then (yes)
    :Request operator refinement with evidence reasons;
    stop
  else (system / simulation incomplete)
    :Return system-recovery actions;
    :Do not ask operator to revise intent;
    stop
  endif
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Present candidate comparison, selected strategy,\nScenarioSpec, RunArtifact, and evidence summary;
  if (Evidence allows deployment and not dry run?) then (yes)
    :Save selected-candidate deployment context;
  else (no)
    :Return evidence-ready or blocked summary;
    stop
  endif
}

partition "Operator / Chat UI" {
  :DEPLOY, DO_NOT_DEPLOY, or REQUEST_REVISION;
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  if (Deploy?) then (yes)
    :Validate selected scenario/run context;
    :POST /deployment/simulated-deploy;
  else (no)
    :Clear or retain session according to decision;
    :Return non-deploy decision message;
    stop
  endif
}

partition "TRT API Deployment Guard" {
  if (M12 automated comparison mode?) then (yes)
    :Block deployment and record suppression reason;
  elseif (Evidence and selected candidate match?) then (yes)
    :Update current state, digital-twin defaults,\nTime-Arrival state, and deployment audit;
  else (no)
    :Reject deployment;
  endif
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Clear deployment session state;
  :Return deployment result;
}

stop

legend right
  Primary workflow IDs:
  - ChatOperatorTaskAllocationDemo
  - IntentToPatchReviewDemo
  - PatchReleaseApprovalDemo
  - ReleasedTRTToReconciliationDemo
  - GenerateScenarioSpecDemo

  Candidate simulations are strictly sequential.
  Post-simulation LLM regeneration is not performed.
endlegend

@enduml
