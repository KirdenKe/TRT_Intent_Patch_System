@startuml
title n8n Workflow Activity Diagram - Task Allocation Orchestration

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam wrapWidth 170
skinparam ArrowFontSize 16
skinparam activity {
  FontSize 18
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #475569
}
skinparam partition {
  FontSize 18
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #0F172A
}
skinparam note {
  FontSize 16
  BackgroundColor #FFFBEB
  BorderColor #D97706
}

start

partition "Operator / Chat UI" {
  :Send chat turn;
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Extract session id;
  :Load chat session state;

  if (Global cancel?) then (yes)
    :Clear session state;
    :Return cancelled message;
    stop
  endif

  if (Pending deployment decision?) then (yes)
    :Build direct deployment decision turn;
  elseif (Pending release approval?) then (yes)
    :Build direct approval decision turn;
  elseif (Pending required fields?) then (yes)
    :Merge required fields with chat turn;
  else (new turn)
    :Classify dialogue turn;
  endif

  if (Help or config query?) then (yes)
    :Return help/config answer;
    stop
  elseif (Small talk or unknown?) then (yes)
    :Return conversational response;
    stop
  endif

  :Check required operator fields\noperator_id, intent_text, reason;
  if (Missing required fields?) then (yes)
    :Save required-field session state;
    :Ask clarification;
    stop
  endif
}

partition "Intent to Patch Review\n(sub-workflow)" {
  :Get deterministic intent context\nfrom TRT API;
}

partition "vLLM" {
  :Generate domain-level intent candidate;
}

partition "Intent to Patch Review\n(sub-workflow)" {
  if (Candidate truncated or invalid JSON?) then (yes)
    :Retry candidate generation once;
  endif

  if (LLM proposes supported patch?) then (yes)
    :Normalize domain candidate\nthrough TRT API;
    if (Python normalization accepted?) then (yes)
      :Validate candidate patch\nthrough TRT API;
      if (Candidate patch valid?) then (yes)
        :Return reviewed candidate patch;
      else (no)
        :Return revision request;
        stop
      endif
    else (no)
      :Return Python candidate rejection;
      stop
    endif
  else (clarify / unsupported)
    :Return clarification or unsupported request;
    stop
  endif
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Normalize reviewed candidate context;
  :Summarize candidate patch;
  :Persist reviewed candidate session state;
}

partition "Operator / Chat UI" {
  :Approve, reject, or request revision;
}

partition "Patch Release Approval\n(sub-workflow)" {
  :Normalize release approval input;
  if (Candidate patch present?) then (yes)
    :Prepare pending release\nthrough TRT API;
    :Record operator release decision\nthrough TRT API;
    if (Released?) then (yes)
      :Fetch release audit bundle;
      :Return released notification;
    elseif (Rejected?) then (yes)
      :Return rejected notification;
      stop
    else (needs revision)
      :Return revision notification;
      stop
    endif
  else (no)
    :Return missing candidate patch error;
    stop
  endif
}

partition "Released TRT to Reconciliation\n(sub-workflow)" {
  :Create supervisor reconciliation plan\nfrom released TRT and current state;
  if (Plan ready?) then (ready)
    :Return ready plan;
  elseif (Waiting for checkpoint?) then (waiting)
    :Return waiting plan;
    stop
  elseif (Degraded switch?) then (degraded)
    :Return degraded plan;
  else (rejected)
    :Return rejected plan;
    stop
  endif
}

partition "Generate ScenarioSpec\n(sub-workflow)" {
  :Validate ScenarioSpec context;
  if (Baseline scenario needed?) then (yes)
    :Normalize generation request;
    if (Request complete?) then (yes)
      :Generate ScenarioSpec\nthrough TRT API;
    else (no)
      :Return missing ScenarioSpec fields;
      stop
    endif
  else (no effect)
    :Return no-effect response;
    stop
  endif

  if (ScenarioSpec generated?) then (yes)
    :Start Isaac simulation run\nasynchronously through TRT API;
    repeat
      :Wait before polling;
      :Poll simulation run status;
    repeat while (Run still active?) is (yes)

    :Return simulation run result;
    :Summarize RunArtifact evidence\nthrough TRT API;
    :Return evidence summary;
  elseif (Waiting for checkpoint?) then (yes)
    :Return waiting checkpoint;
    stop
  else (rejected)
    :Return rejected generation;
    stop
  endif
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Summarize ScenarioSpec and evidence;
  if (Evidence requests deployment approval?) then (yes)
    :Save pending deployment session state;
  else (no)
    :Clear completed session state;
    :Return final summary;
    stop
  endif
}

partition "Operator / Chat UI" {
  :Approve or decline deployment;
}

partition "Chat Operator Task Allocation\n(parent workflow)" {
  :Parse deployment decision;
  if (Deploy?) then (yes)
    :Validate deployment context;
    if (Deployment context valid?) then (yes)
      :Call simulated deployment\nthrough TRT API;
    endif
    :Clear deployment session state;
    :Return deployment success;
  else (no)
    :Clear or retain session based on decision;
    :Return non-deploy decision message;
  endif
}

stop

legend right
  Abstracted from:
  - chat_operator_task_allocation.workflow.json
  - intent_to_patch_review.workflow.json
  - patch_release_approval.workflow.json
  - released_trt_to_reconciliation.workflow.json
  - generate_scenario_spec.workflow.json
endlegend

@enduml

