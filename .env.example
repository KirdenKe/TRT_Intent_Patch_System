# Copy this file to .env and replace machine-specific values before startup.
# Do not commit the resulting .env file.

# Production model used by trt-api. Checked-in n8n workflows contain matching
# direct-call defaults; see docs/start_host_isaac_runner.md when changing model.
VLLM_CHAT_COMPLETIONS_URL=http://192.168.50.168:26615/v1/chat/completions
VLLM_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-8bit

# Docker-to-Windows Isaac host-runner connection.
ISAAC_HOST_RUNNER_URL=http://host.docker.internal:8765

# Local n8n state directory mounted at /home/node/.n8n.
N8N_DATA_DIR=C:/path/to/n8n_data

# Prefer data/isaac_host_config.json for HOST_PROJECT_ROOT and Isaac paths,
# especially when a Windows username contains a literal dollar sign.
