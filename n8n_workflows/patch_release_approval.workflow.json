{
  "id": "PatchReleaseApprovalDemo",
  "name": "Patch Release Approval Orchestration",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "patch-release-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d6f9c5db-8c61-4f2b-b4ea-ff6955bce8f3",
      "name": "Receive Reviewed Candidate Patch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "patch-release-approval-demo"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/release/prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body.candidate_patch || $json.body }}",
        "options": {}
      },
      "id": "b912cc8d-5e9a-43b9-97fd-db8f199fed32",
      "name": "Prepare Pending Release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { release_id: $json.release_id, status: 'PENDING_OPERATOR_DECISION', approval_url: $execution.resumeUrl || null } }}",
        "options": {}
      },
      "id": "608f5684-76bd-4fdd-8168-c4d5298e3e1c",
      "name": "Return Pending Release",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "89d79fb6-c6bd-4ed5-8e64-2d60227e68e9",
      "name": "Wait for Operator Decision",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        780,
        0
      ],
      "notes": "Resume with JSON fields: decision, comment, operator_id. The release_id comes from the prepared release record."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/release/decision",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { release_id: $('Prepare Pending Release').item.json.release_id, operator_id: $json.body.operator_id || $('Receive Reviewed Candidate Patch').item.json.body.operator_id || $('Receive Reviewed Candidate Patch').item.json.body.candidate_patch?.operator_id, decision: $json.body.decision, comment: $json.body.comment || '' } }}",
        "options": {}
      },
      "id": "df8f9193-c863-404c-b61f-5e8b5521a320",
      "name": "Record Release Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f93b4e74-1030-4bcf-a330-6b284eea5248",
              "leftValue": "={{ $json.status }}",
              "rightValue": "RELEASED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d91617d5-04de-4df5-a2c0-306effd7d1b3",
      "name": "Released?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1300,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "33e0b37a-a5e5-4535-bb58-86cd92c5b7ed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "REJECTED_BY_OPERATOR",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9c15c538-1cb3-486d-968e-83c5504d1e31",
      "name": "Rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1560,
        120
      ]
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8000/audit/{{ $json.audit_id }}",
        "options": {}
      },
      "id": "44809c0f-b883-4871-8e93-c4e8737e4338",
